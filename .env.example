# Connection string for the database the assistant may read.
# Use a dedicated role with SELECT-only grants (see README, "Threat model").
DATABASE_URL=postgres://mcp_reader:change-me@localhost:5432/shop

# Policy file (table/column allowlist, masks, row cap, timeout). Without it every table in `public` is readable, unmasked.
POLICY_FILE=./policy.example.yaml

# JSON-lines audit log of every query. Defaults to stderr.
AUDIT_LOG=./audit.jsonl

# Optional: run the test suites against a real server instead of in-process PGlite.
# Seed it first: psql "$TEST_DATABASE_URL" -f seed/ecommerce.sql
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pg_mcp_guard_test
